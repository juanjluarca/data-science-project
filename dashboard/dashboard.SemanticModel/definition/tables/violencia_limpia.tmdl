	/// Combinación de tipos de violencia (una categoría por denuncia)
	column TIPO_VIOLENCIA_COMBINADA
		dataType: string
		lineageTag: 59cdfc06-e20f-4c5e-b4fe-c8b9bca2adb6
		summarizeBy: none
		sourceColumn: TIPO_VIOLENCIA_COMBINADA

		annotation SummarizationSetBy = Automatic

	partition violencia_limpia = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "violencia_limpia.csv"), [Delimiter = ",", Columns = 26, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    TiposCambiados = Table.TransformColumnTypes(EncabezadosPromovidos, {{"ANO_EMISION", Int64.Type}, {"MES_EMISION_NUM", Int64.Type}, {"FECHA_HECHO", type date}, {"DIA_SEMANA", Int64.Type}, {"HEC_DEPTO", type text}, {"HEC_AREA", type text}, {"VIC_SEXO", type text}, {"VIC_EDAD", Int64.Type}, {"VIC_RANGO_EDAD", type text}, {"VIC_NIV_ESCOLARIDAD", type text}, {"VIC_ES_INDIGENA", type text}, {"VIC_TRABAJA", type text}, {"AGR_SEXO", type text}, {"AGR_EDAD", Int64.Type}, {"DIF_EDAD", Int64.Type}, {"VIC_REL_AGR", type text}, {"HEC_TIPAGRE", type text}, {"VIOLENCIA_FISICA", type text}, {"VIOLENCIA_PSICOLOGICA", type text}, {"VIOLENCIA_SEXUAL", type text}, {"VIOLENCIA_PATRIMONIAL", type text}, {"HEC_RECUR_DENUN", type text}, {"INST_DENUN_HECHO", type text}, {"QUIEN_REPORTA", type text}, {"TOTAL_HIJOS", Int64.Type}, {"MEDIDAS_SEGURIDAD", type text}}, "en-US"),

				    // Etiquetas para mostrar en el reporte. Las columnas originales no cambian.
				    Capitalizar = (texto as nullable text) as nullable text =>
				        if texto = null or texto = "" then texto else Text.Upper(Text.Start(texto, 1)) & Text.Middle(texto, 1),
				    Buscar = (tabla as record, clave as nullable text, valorPorDefecto as any) as any =>
				        if clave = null then valorPorDefecto else Record.FieldOrDefault(tabla, clave, valorPorDefecto),
				    NombreDia = {"Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"},
				    EtiquetaRangoEdad = [ninio = "Niñez (1-13)", adolescente = "Adolescencia (14-18)", #"adulto joven" = "Adulto joven (19-40)", #"adulto medio" = "Adulto medio (41-60)", #"adulto mayor" = "Adulto mayor (61+)", ignorado = "Ignorado"],
				    OrdenRangoEdad = [ninio = 1, adolescente = 2, #"adulto joven" = 3, #"adulto medio" = 4, #"adulto mayor" = 5, ignorado = 6],
				    EtiquetaEscolaridad = [ninguno = "Ninguno", primaria = "Primaria", basicos = "Básicos", diversificado = "Diversificado", universidad = "Universidad", ignorado = "Ignorado"],
				    OrdenEscolaridad = [ninguno = 1, primaria = 2, basicos = 3, diversificado = 4, universidad = 5, ignorado = 6],
				    EtiquetaIndigena = [si = "Sí", no = "No", ignorado = "Ignorado"],
				    EtiquetaRelacion = [#"esposos(as)" = "Cónyuge", conviviente = "Conviviente", #"ex-conyuges" = "Excónyuge", #"otro pariente" = "Otro pariente", #"hermanos(as)" = "Hermano(a)", #"padres/madres" = "Madre o padre", #"hijos(as)" = "Hijo(a)", #"suegros(as)" = "Suegro(a)", #"hijastros(as)" = "Hijastro(a)", #"nietos(as)" = "Nieto(a)"],
				    GrupoRelacion = [#"esposos(as)" = "Pareja actual", conviviente = "Pareja actual", #"ex-conyuges" = "Expareja", #"padres/madres" = "Hijo(a) o yerno/nuera agrede", #"suegros(as)" = "Hijo(a) o yerno/nuera agrede", #"hijos(as)" = "Padre/madre o abuelo(a) agrede", #"hijastros(as)" = "Padre/madre o abuelo(a) agrede", #"nietos(as)" = "Padre/madre o abuelo(a) agrede", #"hermanos(as)" = "Otro familiar", #"otro pariente" = "Otro familiar"],

				    ConFechaRegistro = Table.AddColumn(TiposCambiados, "FECHA_REGISTRO", each #date([ANO_EMISION], [MES_EMISION_NUM], 1), type date),
				    ConDiaSemana = Table.AddColumn(ConFechaRegistro, "DIA_SEMANA_NOMBRE", each if [DIA_SEMANA] = null then "Sin fecha" else NombreDia{[DIA_SEMANA]}, type text),
				    ConSexoVictima = Table.AddColumn(ConDiaSemana, "SEXO_VICTIMA", each Capitalizar([VIC_SEXO]), type text),
				    ConSexoAgresor = Table.AddColumn(ConSexoVictima, "SEXO_AGRESOR", each Capitalizar([AGR_SEXO]), type text),
				    ConArea = Table.AddColumn(ConSexoAgresor, "AREA", each Capitalizar([HEC_AREA]), type text),
				    ConIndigena = Table.AddColumn(ConArea, "INDIGENA", each Buscar(EtiquetaIndigena, [VIC_ES_INDIGENA], "Ignorado"), type text),
				    ConRangoEdad = Table.AddColumn(ConIndigena, "RANGO_EDAD", each Buscar(EtiquetaRangoEdad, [VIC_RANGO_EDAD], "Ignorado"), type text),
				    ConOrdenRangoEdad = Table.AddColumn(ConRangoEdad, "ORDEN_RANGO_EDAD", each Buscar(OrdenRangoEdad, [VIC_RANGO_EDAD], 6), Int64.Type),
				    ConEscolaridad = Table.AddColumn(ConOrdenRangoEdad, "ESCOLARIDAD", each Buscar(EtiquetaEscolaridad, [VIC_NIV_ESCOLARIDAD], "Ignorado"), type text),
				    ConOrdenEscolaridad = Table.AddColumn(ConEscolaridad, "ORDEN_ESCOLARIDAD", each Buscar(OrdenEscolaridad, [VIC_NIV_ESCOLARIDAD], 6), Int64.Type),
				    ConRelacion = Table.AddColumn(ConOrdenEscolaridad, "RELACION", each Buscar(EtiquetaRelacion, [VIC_REL_AGR], "Sin dato"), type text),
				    ConRelacionGrupo = Table.AddColumn(ConRelacion, "RELACION_GRUPO", each Buscar(GrupoRelacion, [VIC_REL_AGR], "Sin dato"), type text),
				    ConTipoCombinado = Table.AddColumn(ConRelacionGrupo, "TIPO_VIOLENCIA_COMBINADA", each
				        if [HEC_TIPAGRE] = null then null
				        else Capitalizar(Text.Replace(Text.Replace(Text.Replace([HEC_TIPAGRE], "psicologica", "psicológica"), "fisica", "física"), "-", " + ")), type text)
				in
				    ConTipoCombinado

	annotation PBI_ResultType = Table

